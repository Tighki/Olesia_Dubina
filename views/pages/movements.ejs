<%- include('../partials/app-top') %>
<header class="page-header"><h1>Приход / Расход</h1><p>Оформление складских операций</p></header>
<% if (errors && errors._form) { %><div class="flash flash-error"><%= errors._form %></div><% } %>
<div class="card glass form-card">
  <form method="post" action="/movements">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group <%= errors && errors.product_id ? 'has-error' : '' %>">
      <label>Товар</label>
      <select name="product_id" required><option value="">Выберите...</option>
      <% products.forEach(p => { %><option value="<%= p.id %>"><%= p.sku %> — <%= p.name %> (<%= p.quantity %>)</option><% }) %>
      </select>
      <% if (errors && errors.product_id) { %><div class="field-error"><%= errors.product_id %></div><% } %>
    </div>
    <div class="form-group"><label>Тип операции</label>
      <select name="type"><option value="in">Приход</option><option value="out">Расход</option></select>
    </div>
    <div class="form-group <%= errors && errors.qty ? 'has-error' : '' %>">
      <label>Количество</label><input type="number" name="qty" min="1" value="1" required>
      <% if (errors && errors.qty) { %><div class="field-error"><%= errors.qty %></div><% } %>
    </div>
    <div class="form-group"><label>Примечание</label><textarea name="note" rows="2"></textarea></div>
    <button type="submit" class="btn btn-primary"><%- icon('arrow-left-right', 18) %> Оформить</button>
  </form>
</div>
<%- include('../partials/app-bottom') %>
