<%- include('../partials/app-top') %>
<header class="page-header"><h1><%= product && product.id ? 'Редактирование' : 'Новый товар' %></h1></header>
<div class="card glass form-card">
  <form method="post" action="<%= product && product.id ? '/products/' + product.id : '/products' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group <%= errors && errors.sku ? 'has-error' : '' %>">
      <label>SKU</label><input name="sku" class="mono" value="<%= product ? product.sku : '' %>" required>
      <% if (errors && errors.sku) { %><div class="field-error"><%= errors.sku %></div><% } %>
    </div>
    <div class="form-group <%= errors && errors.name ? 'has-error' : '' %>">
      <label>Название</label><input name="name" value="<%= product ? product.name : '' %>" required>
      <% if (errors && errors.name) { %><div class="field-error"><%= errors.name %></div><% } %>
    </div>
    <div class="form-group"><label>Категория</label>
      <select name="category_id"><option value="">—</option>
      <% categories.forEach(c => { %><option value="<%= c.id %>" <%= product && product.category_id == c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
      </select>
    </div>
    <div class="form-group"><label>Количество</label><input type="number" name="quantity" min="0" value="<%= product ? product.quantity : 0 %>" required></div>
    <div class="form-group"><label>Ед. изм.</label><input name="unit" value="<%= product ? product.unit : 'шт' %>" required></div>
    <div class="form-group"><label>Мин. остаток</label><input type="number" name="min_stock" min="0" value="<%= product ? product.min_stock : 5 %>" required></div>
    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a href="/products" class="btn btn-secondary" style="margin-left:.5rem">Отмена</a>
  </form>
</div>
<%- include('../partials/app-bottom') %>
