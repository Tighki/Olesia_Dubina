<%- include('../partials/head', { title }) %>
<div class="auth-wrap">
  <div class="auth-card glass">
    <div class="auth-brand">
      <img src="/img/logo.svg" alt="СкладУчёт">
      <h1>Вход в систему</h1>
      <p style="color:var(--text-muted);font-size:.85rem">ИС складского учёта</p>
    </div>
    <% if (errors && errors._form) { %><div class="flash flash-error"><%= errors._form %></div><% } %>
    <% if (!isProduction) { %>
    <div class="demo-credentials">
      <p class="demo-credentials__title">Тестовые данные для входа</p>
      <% [['admin@warehouse.local','Admin123!','Admin','badge-admin'],['user@warehouse.local','User123!','User',''],['maria.sidorova@warehouse.local','User123!','User',''],['kozlov@warehouse.local','User123!','User','']].forEach(([e,p,r,b]) => { %>
      <button type="button" class="demo-row" data-email="<%= e %>" data-password="<%= p %>">
        <span class="demo-row__role badge <%= b %>"><%= r %></span>
        <span class="demo-row__cred"><span class="mono"><%= e %></span> · <%= p %></span>
      </button>
      <% }) %>
      <p class="demo-credentials__hint">Нажмите на строку — поля заполнятся автоматически</p>
    </div>
    <% } %>
    <form method="post" action="/login" id="login-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group <%= errors && errors.email ? 'has-error' : '' %>">
        <label>Email</label>
        <input type="email" name="email" value="<%= values.email || '' %>" required autocomplete="email">
        <% if (errors && errors.email) { %><div class="field-error"><%= errors.email %></div><% } %>
      </div>
      <div class="form-group <%= errors && errors.password ? 'has-error' : '' %>">
        <label>Пароль</label>
        <div class="pw-wrap">
          <input type="password" name="password" required autocomplete="current-password">
          <button type="button" class="pw-toggle" aria-label="Показать пароль"><%- icon('eye', 18) %></button>
        </div>
        <% if (errors && errors.password) { %><div class="field-error"><%= errors.password %></div><% } %>
      </div>
      <button type="submit" class="btn btn-primary btn-block"><%- icon('log-in', 18) %> Войти</button>
    </form>
    <p style="text-align:center;margin-top:1rem;font-size:.85rem">Нет аккаунта? <a href="/register">Регистрация</a></p>
  </div>
</div>
<%- include('../partials/foot') %>
